// © original work — independent implementation inspired by the publicly documented
// "Turtle Soup" sweep-and-reject concept (swing liquidity, same-bar rejection,
// multi-timeframe, invalidation on later close-through). Not a copy of any
// protected script's source code.
//@version=6
indicator("Turtle Soup - (Original by Sam)", overlay = true, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────── Swing Lookback (user-configurable range) ─────────────────────────
// Replaces the old fixed "var int SWING_LOOKBACK = 5". The user now sets a
// Min/Max range; the two ends are normalized so it still works if entered
// reversed, and every place in the script that previously used the single
// SWING_LOOKBACK constant now uses lookbackMin or lookbackMax as appropriate.
swingLookbackMin = input.int(
     defval = 5,
     title = "Swing Lookback Minimum",
     minval = 1,
     maxval = 200,
     group = "Swing Lookback",
     tooltip = "Used as the confirmation (right-side) bars for pivot detection, and as the bar offset used to time-anchor a detected swing.")

swingLookbackMax = input.int(
     defval = 10,
     title = "Swing Lookback Maximum",
     minval = 1,
     maxval = 200,
     group = "Swing Lookback",
     tooltip = "Used as the strength (left-side) bars for pivot detection - i.e. how many bars must be lower/higher on the left for a swing to qualify.")

lookbackMin = math.min(swingLookbackMin, swingLookbackMax)
lookbackMax = math.max(swingLookbackMin, swingLookbackMax)

// ───────────────────────── General ─────────────────────────
maxSweeps = input.int(20, "Max Sweeps Displayed", minval = 1, maxval = 200,
     tooltip = "Only the most recent X turtle soup markers are kept on the chart, per timeframe.", group = "General")

showUnconfirmed = input.bool(true, "Show Unconfirmed Sweeps (extra, not in original)",
     tooltip = "Optional: shows a light provisional marker while the reacting bar is still open, before it is confirmed on close. Turn off for behavior that matches the documented 'confirmed on closed bars only' logic exactly.", group = "General")

// ───────────────────────── Timeframe Settings ─────────────────────────
showCurrentTF = input.bool(true, "Show Current TF", group = "Timeframe Settings")

showHTF1 = input.bool(false, "Show HTF 1", inline = "tf1", group = "Timeframe Settings")
tf1      = input.timeframe("15", "", inline = "tf1", group = "Timeframe Settings")

showHTF2 = input.bool(false, "Show HTF 2", inline = "tf2", group = "Timeframe Settings")
tf2      = input.timeframe("60", "", inline = "tf2", group = "Timeframe Settings")

showHTF3 = input.bool(false, "Show HTF 3", inline = "tf3", group = "Timeframe Settings")
tf3      = input.timeframe("240", "", inline = "tf3", group = "Timeframe Settings")

showHTF4 = input.bool(false, "Show HTF 4", inline = "tf4", group = "Timeframe Settings")
tf4      = input.timeframe("1D", "", inline = "tf4", group = "Timeframe Settings")

showHTF5 = input.bool(false, "Show HTF 5", inline = "tf5", group = "Timeframe Settings")
tf5      = input.timeframe("1W", "", inline = "tf5", group = "Timeframe Settings")

// ───────────────────────── Appearance ─────────────────────────
showSweeps  = input.bool(true, "Show Turtle Soups", inline = "ts_drawing",
     tooltip = "Set the visibility and color of turtle soup drawings.", group = "Turtle Soup Appearance")
tsColor     = input.color(color.new(#000000, 0), "", inline = "ts_drawing", group = "Turtle Soup Appearance")
tsMarker    = input.string("💎", "", inline = "ts_drawing",
     tooltip = "Text shown at each swept level - swap the turtle for any emoji or word you like.", group = "Turtle Soup Appearance")

lineStyleInput = input.string("Dotted", "Sweep Line Style", options = ["Solid", "Dashed", "Dotted"], inline = "ts_drawing2", group = "Turtle Soup Appearance")
labelSizeInput = input.string("Tiny", "Label Size", options = ["Tiny", "Small", "Normal", "Large"], inline = "ts_drawing2", group = "Turtle Soup Appearance")

labelHTF = input.bool(true, "Label HTF Timeframe",
     tooltip = "Prefix higher-timeframe turtle markers with their timeframe label (like H1) so you can tell which timeframe was swept.", group = "Turtle Soup Appearance")

// ───────────────────────── Alerts ─────────────────────────
alertsEnabled = input.bool(true, "Enable Alerts", tooltip = "Master alert toggle.", group = "Alerts")

session1On = input.bool(true, "Session 1", inline = "window1", group = "Alerts")
session1   = input.session("0930-1600", "", inline = "window1", group = "Alerts")

session2On = input.bool(false, "Session 2", inline = "window2", group = "Alerts")
session2   = input.session("2000-0000", "", inline = "window2", group = "Alerts")

session3On = input.bool(false, "Session 3", inline = "window3", group = "Alerts")
session3   = input.session("0200-0500", "", inline = "window3", group = "Alerts")

alertOnSweep = input.bool(true, "Alert on Turtle Soup", group = "Alerts")
buysideMsg   = input.string("Buyside liquidity was swept and rejected (turtle soup).", "Buyside Swept Message", group = "Alerts")
sellsideMsg  = input.string("Sellside liquidity was swept and rejected (turtle soup).", "Sellside Swept Message", group = "Alerts")

// ───────────────────────── Helpers ─────────────────────────
getLineStyle(s) =>
    s == "Solid" ? line.style_solid : s == "Dashed" ? line.style_dashed : line.style_dotted

getLabelSize(s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : size.large

inAnySession() =>
    s1 = session1On and not na(time(timeframe.period, session1))
    s2 = session2On and not na(time(timeframe.period, session2))
    s3 = session3On and not na(time(timeframe.period, session3))
    s1 or s2 or s3

fireAlert(isBull) =>
    if alertsEnabled and alertOnSweep and inAnySession()
        alert(isBull ? buysideMsg : sellsideMsg, alert.freq_once_per_bar_close)
    true

// ───────────────────────── Human-readable timeframe labels ─────────────────────────
// input.timeframe() returns raw strings like "60" or "240" for hour-based
// timeframes, which is what was showing up on chart labels instead of
// something readable. This converts those raw minute-strings into "1h",
// "4h", etc., while leaving D/W/M/S-suffixed strings (already readable) alone.
formatTF(tf) =>
    string result = tf
    isSpecial = str.contains(tf, "D") or str.contains(tf, "W") or str.contains(tf, "M") or str.contains(tf, "S")
    if not isSpecial
        mins = str.tonumber(tf)
        if not na(mins)
            if mins < 60
                result := str.tostring(mins, "#") + "m"
            else if mins < 1440
                result := str.tostring(mins / 60, "#") + "h"
            else
                result := str.tostring(mins / 1440, "#") + "d"
    result

tf1Label = formatTF(tf1)
tf2Label = formatTF(tf2)
tf3Label = formatTF(tf3)
tf4Label = formatTF(tf4)
tf5Label = formatTF(tf5)

// ───────────────────────── Pivot + sweep detection ─────────────────────────
// Returns TIME anchors (not bar_index) so the result is safe to draw with
// regardless of whether it came from the main chart or from request.security().
// Uses the shared lookbackMin/lookbackMax range: lookbackMax is the left-side
// (strength) bars, lookbackMin is the right-side (confirmation) bars, which is
// also the correct offset for reading back the bar time of the swing.
detectSweep() =>
    ph = ta.pivothigh(high, lookbackMax, lookbackMin)
    pl = ta.pivotlow(low, lookbackMax, lookbackMin)

    var float lastSwingHigh     = na
    var float lastSwingLow      = na
    var int   lastSwingHighTime = na
    var int   lastSwingLowTime  = na

    if not na(ph)
        lastSwingHigh     := ph
        lastSwingHighTime := time[lookbackMin]
    if not na(pl)
        lastSwingLow     := pl
        lastSwingLowTime := time[lookbackMin]

    bullSweep = not na(lastSwingLow)  and low  < lastSwingLow  and close > lastSwingLow
    bearSweep = not na(lastSwingHigh) and high > lastSwingHigh and close < lastSwingHigh

    [bullSweep, bearSweep, lastSwingHigh, lastSwingLow, lastSwingHighTime, lastSwingLowTime]

// ───────────────────────── Drawing (time-anchored) ─────────────────────────
drawConfirmed(isBull, level, fromTime, tfLabel) =>
    var line  ln = na
    var label lb = na
    if showSweeps
        ln := line.new(fromTime, level, time, level, xloc = xloc.bar_time,
             color = tsColor, style = getLineStyle(lineStyleInput), width = 1)
        txt = (labelHTF and tfLabel != "" ? tfLabel + " " : "") + tsMarker
        lb  := label.new(time, level, txt, xloc = xloc.bar_time,
             style = isBull ? label.style_label_up : label.style_label_down,
             color = color.new(tsColor, 100), textcolor = tsColor, size = getLabelSize(labelSizeInput))
    [ln, lb]

drawProvisional(fromTime, level, isBull, tfLabel) =>
    ln = line.new(fromTime, level, time, level, xloc = xloc.bar_time,
         color = color.new(tsColor, 55), style = line.style_dotted, width = 1)
    txt = (labelHTF and tfLabel != "" ? tfLabel + " " : "") + tsMarker + " ?"
    lb  = label.new(time, level, txt, xloc = xloc.bar_time,
         style = isBull ? label.style_label_up : label.style_label_down,
         color = color.new(tsColor, 100), textcolor = color.new(tsColor, 40), size = getLabelSize(labelSizeInput))
    [ln, lb]

// ───────────────────────── Marker set (per source) ─────────────────────────
// Confirmed markers are tracked with their level+direction so invalidation
// (documented behavior: removed if price later closes back through the level)
// can be checked every bar, and so the oldest can be dropped once over the cap.
invalidateMarkers(array<float> levels, array<bool> bulls, array<line> lines, array<label> labels, currentClose) =>
    if not na(currentClose)
        i = array.size(levels) - 1
        while i >= 0
            lvl = array.get(levels, i)
            isB = array.get(bulls, i)
            invalidated = isB ? currentClose < lvl : currentClose > lvl
            if invalidated
                line.delete(array.get(lines, i))
                label.delete(array.get(labels, i))
                array.remove(levels, i)
                array.remove(bulls, i)
                array.remove(lines, i)
                array.remove(labels, i)
            i -= 1
    true

appendMarker(array<float> levels, array<bool> bulls, array<line> lines, array<label> labels, isBull, level, ln, lb, maxCount) =>
    array.push(levels, level)
    array.push(bulls, isBull)
    array.push(lines, ln)
    array.push(labels, lb)
    while array.size(levels) > maxCount
        line.delete(array.shift(lines))
        label.delete(array.shift(labels))
        array.shift(levels)
        array.shift(bulls)
    true

// ───────────────────────── Pending (unconfirmed) state per source ─────────────────────────
type PendingState
    bool  active    = false
    line  provLine  = na
    label provLabel = na

clearPending(PendingState p) =>
    if not na(p.provLine)
        line.delete(p.provLine)
    if not na(p.provLabel)
        label.delete(p.provLabel)
    p.active    := false
    p.provLine  := na
    p.provLabel := na
    true

// ───────────────────────── Per-source processing ─────────────────────────
// confirmed = has this source's bar (main or HTF) actually closed.
// confirmedClose = that bar's close, only passed in on the bar it confirms (else na).
processSource(array<float> levels, array<bool> bulls, array<line> lines, array<label> labels, PendingState p,
     bull, bear, sh, sl, shTime, slTime, tfLabel, confirmed, confirmedClose, maxCount) =>
    sweepNow  = bull or bear
    isBullNow = bull
    levelNow  = bull ? sl : sh
    timeNow   = bull ? slTime : shTime

    if confirmed
        if p.active
            clearPending(p)
        invalidateMarkers(levels, bulls, lines, labels, confirmedClose)
        if sweepNow
            [ln, lb] = drawConfirmed(isBullNow, levelNow, timeNow, tfLabel)
            appendMarker(levels, bulls, lines, labels, isBullNow, levelNow, ln, lb, maxCount)
            fireAlert(isBullNow)
        true
    else
        if sweepNow and showUnconfirmed
            if p.active
                clearPending(p)
            [ln, lb] = drawProvisional(timeNow, levelNow, isBullNow, tfLabel)
            p.active    := true
            p.provLine  := ln
            p.provLabel := lb
        else if p.active
            clearPending(p)
        true

// ───────────────────────── Current timeframe ─────────────────────────
var float[] curLevels = array.new_float()
var bool[]  curBulls  = array.new_bool()
var line[]  curLines  = array.new_line()
var label[] curLabels = array.new_label()
var PendingState pCur = PendingState.new()

if showCurrentTF
    [bull, bear, sh, sl, shTime, slTime] = detectSweep()
    curClose = barstate.isconfirmed ? close : na
    processSource(curLevels, curBulls, curLines, curLabels, pCur, bull, bear, sh, sl, shTime, slTime, "", barstate.isconfirmed, curClose, maxSweeps)

// ───────────────────────── Higher timeframe wrapper ─────────────────────────
htfSweep(tf) =>
    [b, r, sh, sl, shTime, slTime] = request.security(syminfo.tickerid, tf, detectSweep(), lookahead = barmerge.lookahead_off)
    htfConfirmed = request.security(syminfo.tickerid, tf, barstate.isconfirmed, lookahead = barmerge.lookahead_off)
    htfClose     = request.security(syminfo.tickerid, tf, close, lookahead = barmerge.lookahead_off)
    [b, r, sh, sl, shTime, slTime, htfConfirmed, htfClose]

var float[] h1Levels = array.new_float()
var bool[]  h1Bulls  = array.new_bool()
var line[]  h1Lines  = array.new_line()
var label[] h1Labels = array.new_label()
var PendingState p1 = PendingState.new()

var float[] h2Levels = array.new_float()
var bool[]  h2Bulls  = array.new_bool()
var line[]  h2Lines  = array.new_line()
var label[] h2Labels = array.new_label()
var PendingState p2 = PendingState.new()

var float[] h3Levels = array.new_float()
var bool[]  h3Bulls  = array.new_bool()
var line[]  h3Lines  = array.new_line()
var label[] h3Labels = array.new_label()
var PendingState p3 = PendingState.new()

var float[] h4Levels = array.new_float()
var bool[]  h4Bulls  = array.new_bool()
var line[]  h4Lines  = array.new_line()
var label[] h4Labels = array.new_label()
var PendingState p4 = PendingState.new()

var float[] h5Levels = array.new_float()
var bool[]  h5Bulls  = array.new_bool()
var line[]  h5Lines  = array.new_line()
var label[] h5Labels = array.new_label()
var PendingState p5 = PendingState.new()

if showHTF1
    [b1, r1, sh1, sl1, sht1, slt1, c1, cl1] = htfSweep(tf1)
    processSource(h1Levels, h1Bulls, h1Lines, h1Labels, p1, b1, r1, sh1, sl1, sht1, slt1, tf1Label, c1, c1 ? cl1 : na, maxSweeps)

if showHTF2
    [b2, r2, sh2, sl2, sht2, slt2, c2, cl2] = htfSweep(tf2)
    processSource(h2Levels, h2Bulls, h2Lines, h2Labels, p2, b2, r2, sh2, sl2, sht2, slt2, tf2Label, c2, c2 ? cl2 : na, maxSweeps)

if showHTF3
    [b3, r3, sh3, sl3, sht3, slt3, c3, cl3] = htfSweep(tf3)
    processSource(h3Levels, h3Bulls, h3Lines, h3Labels, p3, b3, r3, sh3, sl3, sht3, slt3, tf3Label, c3, c3 ? cl3 : na, maxSweeps)

if showHTF4
    [b4, r4, sh4, sl4, sht4, slt4, c4, cl4] = htfSweep(tf4)
    processSource(h4Levels, h4Bulls, h4Lines, h4Labels, p4, b4, r4, sh4, sl4, sht4, slt4, tf4Label, c4, c4 ? cl4 : na, maxSweeps)

if showHTF5
    [b5, r5, sh5, sl5, sht5, slt5, c5, cl5] = htfSweep(tf5)
    processSource(h5Levels, h5Bulls, h5Lines, h5Labels, p5, b5, r5, sh5, sl5, sht5, slt5, tf5Label, c5, c5 ? cl5 : na, maxSweeps)

