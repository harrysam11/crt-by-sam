{
  "name": "crt-by-sam",
  "version": "2.0.0",
  "private": true,
  "description": "CRT Institutional Trading Terminal & TradeXGuardian",
  "workspaces": [
    "terminal"
  ],
  "scripts": {
    "dev": "npm --prefix terminal run dev",
    "build": "npm --prefix terminal run build",
    "preview": "npm --prefix terminal run preview",
    "serve": "npm --prefix terminal run serve",
    "serve:rust": "cargo run --release --manifest-path server/Cargo.toml",
    "build:rust": "cargo build --release --manifest-path server/Cargo.toml",
    "build:all": "npm run build && npm run build:rust",
    "cap:sync": "npm --prefix terminal run cap:sync",
    "cap:build": "npm --prefix terminal run cap:build",
    "cap:android": "npm --prefix terminal run cap:android",
    "cap:ios": "npm --prefix terminal run cap:ios",
    "start": "npm --prefix terminal run dev"
  },
  "keywords": [
    "trading",
    "tradingview",
    "terminal",
    "orderflow",
    "propfirm",
    "crypto",
    "stocks",
    "forex"
  ],
  "author": "Sam",
  "license": "MIT"
}
